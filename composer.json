{
    "name": "scylabs/neptune-bundle",
    "type": "symfony-bundle",
    "keywords": [
        "User management"
    ],
    "homepage": "https://github.com/ScyLabs/NeptuneBundle",
    "license": "MIT",
    "description": "Admin bundle all in one",
        "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/CapsulProtect/hook-bundle.git"
        }
    ],
    "require": {
        "php": "^7.3 || ^7.4 || ^8.0",
        "symfony/swiftmailer-bundle": "^3.4",
        "scylabs/hook-bundle": "^1",
        "symfony/translation": "5.4.*",
        "stof/doctrine-extensions-bundle": "^1.3",
        "oyejorge/less.php": "^1",
        "scylabs/css2less": "~1",
        "symfony/form": "5.4.*",
        "symfony/intl": "5.4.*"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "ScyLabs\\NeptuneBundle\\": "./"
        }
    },
    "authors": [
        {
            "name": "Alexandre Sciacca",
            "email": "alexandre.sciacca@gmail.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
